# HeirRight Friday dry-run system
DEPLOYMENT_KEY=heirright
COUNTY_LIST=miami-dade
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Production app/auth
APP_PUBLIC_URL=https://surface.heirright.com
AUTH_REQUIRED=true
AUTH_ALLOWED_DOMAINS=heirright.com,solvys.io,texasequitypros.com
AUTH_ALLOWED_EMAILS=
AUTH_SESSION_SECRET=
AUTH_SESSION_COOKIE=hr_session
AUTH_SESSION_TTL_SECONDS=43200
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://surface.heirright.com/auth/callback
HEIRRIGHT_WORKER_URL=
HEIRRIGHT_API_TOKEN=

# Podio export/readback path
# Production should use team-durable app auth or server refresh access.
# Browser OAuth reconnect is available as a temporary single-browser session path only.
PODIO_ACCESS_TOKEN=
PODIO_DURABLE_REFRESH_TOKEN=
PODIO_TEAM_REFRESH_TOKEN=
PODIO_BROWSER_REFRESH_TOKEN=
PODIO_DURABLE_AUTH_REQUIRED=true
PODIO_OAUTH_REDIRECT_URI=https://surface.heirright.com/api/podio/oauth/callback
PODIO_OAUTH_REFRESH_KV_KEY=heirright:podio:team-refresh
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_APP_TOKEN=
PODIO_APP_ID=24265877
PODIO_FIELD_MAP_JSON=
PODIO_REPORT_FILE_URL=
PODIO_LIVE_WRITE_APPROVED=false
PODIO_TEST_PHONE=
PODIO_TEST_EMAIL=
PODIO_LEAD_POINT_PROFILE_ID=
PODIO_TEST_PROPERTY_ADDRESS=
PODIO_TEST_CASE_NUMBER=
PODIO_TEST_COUNTY=miami-dade

# Browser audit fallback if Podio API is blocked/unavailable
PODIO_LOGIN_URL=
PODIO_WORKSPACE_NAME=Texas Equity Pros LLC
PODIO_APP_NAME=Leads

# Optional later systems, not required for the first no-enrichment milestone
ANTHROPIC_API_KEY=
SKIPTRACE_PROVIDER=
SKIPTRACE_API_KEY=
APIFY_TOKEN=
APIFY_SKIPTRACE_ACTOR=apivault_labs/skip-trace-people-finder
APIFY_SKIPTRACE_SOURCE=merge
APIFY_SKIPTRACE_MAX_RESULTS=10
RAILWAY_TOKEN=
VERCEL_TOKEN=

# idiCORE Discovery source
# Portal mode is the confirmed operator workflow. It never stores an idiCORE password.
IDI_CORE_LOGIN_URL=https://login.idicore.com/
IDI_CORE_PORTAL_URL=https://idicore.com/search/PropertySearch
IDI_CORE_ACCOUNT_ID=
IDI_CORE_ACCOUNT_COMPANY=
IDI_CORE_OPERATOR_EMAIL=
# API mode is only for vendor-provisioned backend access.
# IDI_CORE_API_TOKEN is the shared private backend token for all approved users; operators may paste a personal key in-app for their own run without replacing this value.
# IDI_CORE_API_KEY remains supported as a legacy alias, but new deployments should use IDI_CORE_API_TOKEN.
IDI_CORE_API_URL=
IDI_CORE_API_TOKEN=
IDI_CORE_API_KEY=
IDI_CORE_LIVE_RUN_APPROVED=false

# Browserbase-backed source workflows
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_API_BASE=https://api.browserbase.com
BROWSERBASE_BATCH_APPROVAL_REQUIRED=true
BROWSERBASE_BATCH_RUN_APPROVED=false
BROWSERBASE_BATCH_MAX_SESSIONS=10
BROWSERBASE_BATCH_CONCURRENCY=2
BROWSERBASE_PROXY_ENABLED=false
TAX_COLLECTOR_BROWSERBASE_FUNCTION_ID=
TAX_COLLECTOR_BROWSERBASE_PROXY_ENABLED=false
TAX_COLLECTOR_BROWSER_WORKFLOW_URL=
TAX_COLLECTOR_BROWSER_WORKFLOW_TOKEN=
OBITUARY_VITAL_BROWSERBASE_FUNCTION_ID=
OBITUARY_VITAL_WORKFLOW_URL=
OBITUARY_VITAL_WORKFLOW_TOKEN=
MIAMI_DADE_CLERK_AUTH_KEY=
MIAMI_DADE_CLERK_API_BASE=https://www2.miamidadeclerk.gov/Developers/api

# Google Workspace export/readback
GOOGLE_WORKSPACE_WEBHOOK_URL=
GOOGLE_WORKSPACE_WEBHOOK_SECRET=
GOOGLE_LIVE_WRITE_APPROVED=false
GOOGLE_WORKSPACE_DESTINATION=heirright
