{
  "name": "probate-lead-engine",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:production": "pnpm --filter @ple/types build && pnpm --filter @ple/worker build && pnpm --filter @ple/artifact build:production",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:s44-hold": "node --test scripts/s44-artifact-hold.test.mjs",
    "test:s44-evidence": "node --test scripts/s44-michelet-discovery-evidence.test.mjs",
    "test:vercel-trace": "node apps/artifact/test/s38-vercel-function-trace.test.mjs",
    "pretest:e2e": "pnpm --filter @ple/artifact build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.12"
    }
  }
}
