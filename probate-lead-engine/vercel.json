{
  "buildCommand": "pnpm build:production",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/artifact/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/latest-run.json",
      "destination": "/api/runtime-artifact?name=latest-run.json"
    },
    {
      "source": "/daily-run.json",
      "destination": "/api/runtime-artifact?name=daily-run.json"
    },
    {
      "source": "/fresh-lead-batch.json",
      "destination": "/api/runtime-artifact?name=fresh-lead-batch.json"
    },
    {
      "source": "/qualification-review.json",
      "destination": "/api/runtime-artifact?name=qualification-review.json"
    }
  ],
  "functions": {
    "api/discovery/idi-asset-search/extract.js": {
      "includeFiles": "apps/artifact/node_modules/{pdfjs-dist/{package.json,legacy/build/{pdf.mjs,pdf.worker.mjs},standard_fonts/*},@napi-rs/canvas/{package.json,geometry.js}}",
      "excludeFiles": "apps/artifact/node_modules/{pdfjs-dist/**/*.map,@napi-rs/canvas-*/**}",
      "maxDuration": 60
    },
    "api/**/*.js": {
      "excludeFiles": "apps/artifact/dist/**/*.map",
      "maxDuration": 60
    }
  }
}
