{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AUTH_REQUIRED",
    "PODIO_ACCESS_TOKEN",
    "PODIO_REFRESH_TOKEN",
    "PODIO_CLIENT_ID",
    "PODIO_CLIENT_SECRET",
    "PODIO_APP_TOKEN",
    "PODIO_APP_ID",
    "PODIO_SPACE_ID",
    "PODIO_LIVE_WRITE_APPROVED",
    "PODIO_CSV_BACKUP_CONFIRMED",
    "PODIO_TEST_PHONE",
    "PODIO_TEST_EMAIL",
    "PODIO_LEAD_POINT_PROFILE_ID",
    "HEIRRIGHT_API_TOKEN",
    "HEIRRIGHT_WORKER_URL",
    "GOOGLE_WORKSPACE_WEBHOOK_URL",
    "GOOGLE_WORKSPACE_WEBHOOK_SECRET",
    "GOOGLE_LIVE_WRITE_APPROVED",
    "HEIRRIGHT_LINEAR_API_KEY",
    "HEIRRIGHT_LINEAR_TEAM_ID",
    "HEIRRIGHT_LINEAR_PROJECT_ID",
    "HEIRRIGHT_LINEAR_DEFAULT_ASSIGNEE_ID",
    "HEIRRIGHT_LINEAR_LABEL_IDS",
    "HEIRRIGHT_LINEAR_INCIDENT_LABEL_IDS"
  ],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
